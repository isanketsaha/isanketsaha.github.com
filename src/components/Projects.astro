---
const projects = [
  {
    name: "Tulip School Platform",
    description:
      "A live school platform for attendance, fees, parent communication, and reporting.",
    href: "/projects#tulip-school-platform",
    label: "School operations",
  },
  {
    name: "AI Agents for Lakehouse Operations",
    description:
      "A high-level architecture for agents that investigate platform health using event data and live operational context.",
    href: "/projects#ai-lakehouse-agents",
    label: "Data + AI",
  },
];
---

<section class="selected-work" aria-labelledby="selected-work-title">
  <div class="section-heading">
    <h2 id="selected-work-title">Selected work</h2>
    <a href="/projects">All projects <span aria-hidden="true">→</span></a>
  </div>
  <div class="projects-list">
    {
      projects.map((project) => (
        <a class="project-item" href={project.href}>
          <span class="project-label">{project.label}</span>
          <h3>{project.name}</h3>
          <p class="project-desc">{project.description}</p>
          <span class="project-link">
            View project <span aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<style>
  section {
    margin-bottom: 2.5rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--light);
  }

  .section-heading > a {
    color: var(--accent);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project-item {
    padding: 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s;
    color: inherit;
    text-decoration: none;
  }
  .project-item:hover {
    border-color: var(--accent);
  }

  .project-label {
    display: inline-block;
    margin-bottom: 0.5rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-item h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .project-desc {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.65rem;
    line-height: 1.5;
  }

  .project-link {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 500;
  }

  @media (max-width: 550px) {
    .projects-list {
      grid-template-columns: 1fr;
    }
  }
</style>
