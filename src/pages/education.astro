---
import Layout from '../layouts/Layout.astro';

const education = {
  degree: "B.Tech in Information Technology",
  university: "GITAM University",
  period: "2011 – 2015",
  location: "Visakhapatnam, India",
  highlights: [
    "Focused on software engineering and database systems",
    "Active participant in coding competitions",
    "Final year project on distributed systems"
  ]
};

const certifications = [
  {
    name: "Databricks Certified Data Engineer Associate",
    issuer: "Databricks",
    date: "Sep 2024",
    icon: "DB",
    description: "Validates expertise in data engineering using Databricks Lakehouse Platform, including ETL processes, data pipelines, and Delta Lake."
  },
  {
    name: "AWS Certified Cloud Practitioner (CLF-C02)",
    issuer: "Amazon Web Services",
    date: "Jul 2024",
    icon: "AWS",
    description: "Demonstrates foundational understanding of AWS Cloud, including core services, security, architecture, and pricing."
  },
  {
    name: "Oracle Certified Professional, Java SE 6",
    issuer: "Oracle",
    date: "Nov 2014",
    icon: "OCP",
    description: "Professional-level certification validating advanced Java programming skills and object-oriented design principles."
  }
];
---

<Layout title="Education — Sanket Saha" description="Education and professional certifications of Sanket Saha">
  <div class="page-header">
    <h1>Education & Certifications</h1>
    <p>Academic background and professional credentials.</p>
  </div>

  <section class="education-section">
    <h2>Education</h2>
    <div class="education-card">
      <div class="edu-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/></svg>
      </div>
      <div class="edu-content">
        <h3>{education.degree}</h3>
        <p class="edu-university">{education.university}</p>
        <p class="edu-meta">{education.period} · {education.location}</p>
        <ul class="edu-highlights">
          {education.highlights.map(h => <li>{h}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="certs-section">
    <h2>Certifications</h2>
    <div class="certs-grid">
      {certifications.map(cert => (
        <div class="cert-card">
          <div class="cert-header">
            <span class="cert-icon">{cert.icon}</span>
            <span class="cert-date">{cert.date}</span>
          </div>
          <h3>{cert.name}</h3>
          <p class="cert-issuer">{cert.issuer}</p>
          <p class="cert-desc">{cert.description}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: var(--muted);
  }

  section {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--light);
    margin-bottom: 1rem;
  }

  .education-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .edu-icon {
    width: 56px;
    height: 56px;
    background: var(--accent);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .edu-icon svg {
    width: 28px;
    height: 28px;
    color: white;
  }

  .edu-content h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .edu-university {
    font-size: 0.95rem;
    color: var(--accent);
    margin-bottom: 0.15rem;
  }
  .edu-meta {
    font-size: 0.85rem;
    color: var(--light);
    margin-bottom: 0.75rem;
  }

  .edu-highlights {
    list-style: none;
  }
  .edu-highlights li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }
  .edu-highlights li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .cert-card {
    padding: 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.2s;
  }
  .cert-card:hover {
    border-color: var(--accent);
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .cert-icon {
    width: 36px;
    height: 36px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: white;
  }

  .cert-date {
    font-size: 0.75rem;
    color: var(--light);
    padding: 0.2rem 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .cert-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    line-height: 1.4;
  }

  .cert-issuer {
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .cert-desc {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 550px) {
    .education-card {
      flex-direction: column;
      gap: 1rem;
    }
    .edu-icon {
      width: 48px;
      height: 48px;
    }
    .edu-icon svg {
      width: 24px;
      height: 24px;
    }
  }
</style>
