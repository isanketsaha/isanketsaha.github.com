---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
---

<Layout title="Sanket Saha — Senior Data Engineer">
  <header>
    <div class="header-top">
      <div>
        <h1>Sanket Saha</h1>
        <p class="subtitle">Senior Data Engineer · <span class="hl">JP Morgan Chase</span></p>
      </div>
      <div class="header-right">
        <span class="location">Hyderabad, India</span>
        <div class="social-icons">
          <a href="mailto:sanketsaha@gmail.com" title="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </a>
          <a href="https://github.com/isanketsaha" target="_blank" title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
          </a>
          <a href="https://linkedin.com/in/sanket-saha" target="_blank" title="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 11-.001-4.14 2.07 2.07 0 01.001 4.14zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.78C.8 0 0 .77 0 1.73v20.54C0 23.23.8 24 1.78 24h20.44c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="story">
      <p>I started in backend engineering, moved through full-stack at Deloitte, and found my home in data. For the past 5 years, I've been building systems that move and transform data at scale.</p>
      <p>Today, I build lakehouse platforms that ingest <strong>40TB daily</strong> and serve 30+ downstream applications. I'm now extending these systems with AI agents that diagnose pipeline failures before humans notice.</p>
    </div>

    <div class="header-actions">
      <a href="/resume.pdf" download class="btn primary">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor"><path d="M10 3a1 1 0 011 1v7.586l2.293-2.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 11.586V4a1 1 0 011-1z"/><path d="M3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"/></svg>
        Download Resume
      </a>
      <div class="badges">
        <span>11 years</span>
        <span>Databricks Certified</span>
        <span>AWS Certified</span>
      </div>
    </div>
  </header>

  <Experience />
  <Skills />
</Layout>

<style>
  header { margin-bottom: 2.5rem; }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 1rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }
  .subtitle .hl { color: var(--accent); font-weight: 500; }

  .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .location {
    font-size: 0.85rem;
    color: var(--light);
  }

  .social-icons {
    display: flex;
    gap: 0.5rem;
  }
  .social-icons a {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--muted);
    transition: all 0.15s;
  }
  .social-icons a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .social-icons svg { width: 18px; height: 18px; }

  .story { margin-bottom: 1.25rem; }
  .story p {
    color: var(--muted);
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
  }
  .story strong { color: var(--text); }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s;
  }
  .btn.primary {
    background: var(--accent);
    color: white;
  }
  .btn.primary:hover { opacity: 0.9; }

  .badges {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .badges span {
    font-size: 0.7rem;
    color: var(--light);
    padding: 0.2rem 0.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  @media (max-width: 550px) {
    .header-top { flex-direction: column; gap: 1rem; }
    h1 { font-size: 1.75rem; }
  }
</style>
