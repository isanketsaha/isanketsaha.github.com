---
import Layout from "../layouts/Layout.astro";

const projects: {
  name: string;
  id?: string;
  description: string;
  status: string;
  featured: boolean;
  architecture?: boolean;
  sections: { label?: string; points: string[] }[];
  tech: string[];
  links: { label: string; href: string }[];
}[] = [
  {
    name: "Tulip School Platform",
    id: "tulip-school-platform",
    description:
      "School management platform for Tulip English School, West Bengal.",
    status: "Live",
    featured: true,
    sections: [
      {
        label: "Reporting Lambda",
        points: [
          "Python AWS Lambda routes events by rule name to report handlers",
          "Daily transaction report parses bank credit alerts stored in S3 and emails a summary",
          "Low-stock alert pulls inventory from the school API and emails items below threshold",
          "Renders HTML emails with Jinja2 templates",
        ],
      },
    ],
    tech: ["Python", "AWS Lambda", "S3", "Jinja2"],
    links: [
      { label: "Live Site", href: "https://tulipschool.co.in" },
      { label: "GitHub", href: "https://github.com/isanketsaha/tulip-bot" },
    ],
  },
  {
    name: "AI Agents for Lakehouse Operations",
    id: "ai-lakehouse-agents",
    description:
      "A high-level architecture for using AI agents to investigate data-platform health from event data and live operational context.",
    status: "Architecture",
    featured: true,
    architecture: true,
    sections: [
      {
        label: "How it works",
        points: [
          "Spark event data is normalized into a queryable PostgreSQL store, giving agents consistent operational history",
          "A coordinator hands a request through focused agents, each with a bounded responsibility and shared session context",
          "MCP integrations retrieve current platform, source-control, and issue-tracking context so responses can be checked against live state",
          "A separate scheduled observer can surface critical and warning conditions with evidence for follow-up",
        ],
      },
    ],
    tech: ["Google ADK", "Apache Spark", "PostgreSQL", "MCP"],
    links: [],
  },
  {
    name: "OHLC Aggregation Pipeline",
    description:
      "Spring Batch pipeline that turns a stream of price quotes into minute, hour, and day OHLC candles.",
    status: "Complete",
    featured: false,
    sections: [
      {
        points: [
          "Three Spring Batch jobs—minute → hour → day—each feeding the next through concurrent queues",
          "Custom completion policy closes a chunk at each time-window boundary",
          "Async item processing and writing for parallel throughput",
          "Produces current and historical candles for M1, H1, and D1 periods",
        ],
      },
    ],
    tech: ["Java", "Spring Boot", "Spring Batch", "Maven"],
    links: [
      { label: "GitHub", href: "https://github.com/isanketsaha/FxproDemo" },
    ],
  },
  {
    name: "Cron Parser Service",
    description:
      "Java CLI that expands a cron expression into the exact minutes, hours, days, and weekdays it will run.",
    status: "Complete",
    featured: false,
    sections: [
      {
        points: [
          "Supports wildcards (*), lists (,), ranges (-), steps (/), and numeric values",
          "Includes unit-tested parser and utility functions",
        ],
      },
    ],
    tech: ["Java 11", "Maven", "JUnit"],
    links: [
      {
        label: "GitHub",
        href: "https://github.com/isanketsaha/CronParserService",
      },
    ],
  },
];
---

<Layout
  title="Projects — Sanket Saha"
  description="Side projects and open source work by Sanket Saha"
>
  <div class="page-header">
    <h1>Projects</h1>
    <p>
      Selected projects, from a live school platform to AI-assisted operations
      and focused Java services.
    </p>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <article
          id={project.id}
          class:list={["project-card", { featured: project.featured }]}
        >
          <div class="project-header">
            <h2>{project.name}</h2>
            <span class={`status status-${project.status.toLowerCase()}`}>
              {project.status}
            </span>
          </div>

          <p class="project-desc">{project.description}</p>

          {project.sections.map((section) => (
            <div class="project-section">
              {section.label && <h3>{section.label}</h3>}
              <ul class="project-details">
                {section.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))}

          {project.architecture && (
            <div
              class="architecture"
              role="img"
              aria-label="Illustrative flow: Spark event stream to a normalized event store, then a multi-agent workflow producing a grounded response"
            >
              <div class="architecture-flow">
                <div class="architecture-node">
                  <strong>Spark events</strong>
                  <span>Operational signals</span>
                </div>
                <span class="architecture-arrow" aria-hidden="true">
                  →
                </span>
                <div class="architecture-node">
                  <strong>Event store</strong>
                  <span>Normalized history</span>
                </div>
                <span class="architecture-arrow" aria-hidden="true">
                  →
                </span>
                <div class="architecture-node">
                  <strong>Agent workflow</strong>
                  <span>Focused investigators</span>
                </div>
                <span class="architecture-arrow" aria-hidden="true">
                  →
                </span>
                <div class="architecture-node">
                  <strong>Grounded response</strong>
                  <span>Findings + evidence</span>
                </div>
              </div>
              <p class="architecture-note">
                Agents can query live operational context through MCP
                integrations. This is a conceptual overview, not an internal
                system diagram.
              </p>
            </div>
          )}

          <div class="project-tech">
            {project.tech.map((t) => (
              <span>{t}</span>
            ))}
          </div>

          <div class="project-links">
            {project.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="project-link"
              >
                {link.label === "Live Site" ? (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                  >
                    <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                    <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                  </svg>
                ) : (
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                )}
                {link.label}
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: var(--muted);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .project-card.featured {
    border-color: var(--accent);
  }
  .project-card:hover {
    border-color: var(--accent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .project-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .status {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .status-live {
    background: #dcfce7;
    color: #166534;
  }
  .status-active {
    background: #dbeafe;
    color: #1e40af;
  }
  .status-running {
    background: #fef3c7;
    color: #92400e;
  }
  .status-complete {
    background: var(--border);
    color: var(--text);
  }
  .status-architecture {
    background: #eff6ff;
    color: #1d4ed8;
  }

  @media (prefers-color-scheme: dark) {
    .status-live {
      background: #166534;
      color: #dcfce7;
    }
    .status-active {
      background: #1e40af;
      color: #dbeafe;
    }
    .status-running {
      background: #92400e;
      color: #fef3c7;
    }
  }

  .project-desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .project-section h3 {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .project-details {
    list-style: none;
    margin-bottom: 1rem;
  }
  .project-details li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .project-details li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .architecture {
    margin: 0 0 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
  }
  .architecture-flow {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
  }
  .architecture-node {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--card);
  }
  .architecture-node strong {
    font-size: 0.78rem;
    line-height: 1.35;
  }
  .architecture-node span,
  .architecture-note {
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }
  .architecture-arrow {
    align-self: center;
    color: var(--accent);
  }
  .architecture-note {
    margin-top: 0.75rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }
  .project-tech span {
    font-size: 0.7rem;
    color: var(--text);
    padding: 0.15rem 0.4rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
  }
  .project-link:hover {
    text-decoration: underline;
  }
  .project-link svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 600px) {
    .architecture-flow {
      flex-direction: column;
    }
    .architecture-arrow {
      align-self: center;
      transform: rotate(90deg);
    }
  }

  @media (prefers-color-scheme: dark) {
    .status-architecture {
      background: #172554;
      color: #bfdbfe;
    }
  }
</style>
