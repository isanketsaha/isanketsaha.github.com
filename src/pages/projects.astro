---
import Layout from "../layouts/Layout.astro";

const projects: {
  name: string;
  description: string;
  status: string;
  featured: boolean;
  sections: { label?: string; points: string[] }[];
  tech: string[];
  links: { label: string; href: string }[];
}[] = [
  {
    name: "Tulip School Platform",
    description:
      "School management platform for Tulip English School, West Bengal.",
    status: "Live",
    featured: true,
    sections: [
      {
        label: "Reporting Lambda",
        points: [
          "Python AWS Lambda routes events by rule name to report handlers",
          "Daily transaction report parses bank credit alerts stored in S3 and emails a summary",
          "Low-stock alert pulls inventory from the school API and emails items below threshold",
          "Renders HTML emails with Jinja2 templates",
        ],
      },
    ],
    tech: ["Python", "AWS Lambda", "S3", "boto3", "Jinja2", "pandas"],
    links: [
      { label: "Live Site", href: "https://tulipschool.co.in" },
      { label: "GitHub", href: "https://github.com/isanketsaha/tulip-bot" },
    ],
  },
  {
    name: "OHLC Aggregation Pipeline",
    description:
      "Spring Batch pipeline that turns a stream of price quotes into minute, hour, and day OHLC candles.",
    status: "Complete",
    featured: false,
    sections: [
      {
        points: [
          "Three Spring Batch jobs—minute → hour → day—each feeding the next through concurrent queues",
          "Custom completion policy closes a chunk at each time-window boundary",
          "Async item processing and writing for parallel throughput",
          "Produces current and historical candles for M1, H1, and D1 periods",
        ],
      },
    ],
    tech: [
      "Java",
      "Spring Boot",
      "Spring Batch",
      "Spring Integration",
      "WebFlux",
      "Maven",
    ],
    links: [
      { label: "GitHub", href: "https://github.com/isanketsaha/FxproDemo" },
    ],
  },
  {
    name: "Cron Parser Service",
    description:
      "Java CLI that expands a cron expression into the exact minutes, hours, days, and weekdays it will run.",
    status: "Complete",
    featured: false,
    sections: [
      {
        points: [
          "Supports wildcards (*), lists (,), ranges (-), steps (/), and numeric values",
          "Includes unit-tested parser and utility functions",
        ],
      },
    ],
    tech: ["Java 11", "Maven", "JUnit"],
    links: [
      {
        label: "GitHub",
        href: "https://github.com/isanketsaha/CronParserService",
      },
    ],
  },
];
---

<Layout
  title="Projects — Sanket Saha"
  description="Side projects and open source work by Sanket Saha"
>
  <div class="page-header">
    <h1>Projects</h1>
    <p>
      Selected projects, from a live school platform to focused Java services.
    </p>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <article class:list={["project-card", { featured: project.featured }]}>
          <div class="project-header">
            <h2>{project.name}</h2>
            <span class={`status status-${project.status.toLowerCase()}`}>
              {project.status}
            </span>
          </div>

          <p class="project-desc">{project.description}</p>

          {project.sections.map((section) => (
            <div class="project-section">
              {section.label && <h3>{section.label}</h3>}
              <ul class="project-details">
                {section.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))}

          <div class="project-tech">
            {project.tech.map((t) => (
              <span>{t}</span>
            ))}
          </div>

          <div class="project-links">
            {project.links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer"
                class="project-link"
              >
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
                {link.label === "Live Site" ? (
                  <svg viewBox="0 0 20 20" fill="currentColor">
                    <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
                    <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 016 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                )}
                {link.label}
              </a>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .page-header p {
    color: var(--muted);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .project-card {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.2s;
  }
  .project-card.featured {
    border-color: var(--accent);
  }
  .project-card:hover {
    border-color: var(--accent);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .project-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .status {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .status-live {
    background: #dcfce7;
    color: #166534;
  }
  .status-active {
    background: #dbeafe;
    color: #1e40af;
  }
  .status-running {
    background: #fef3c7;
    color: #92400e;
  }
  .status-complete {
    background: var(--border);
    color: var(--muted);
  }

  @media (prefers-color-scheme: dark) {
    .status-live {
      background: #166534;
      color: #dcfce7;
    }
    .status-active {
      background: #1e40af;
      color: #dbeafe;
    }
    .status-running {
      background: #92400e;
      color: #fef3c7;
    }
  }

  .project-desc {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .project-section h3 {
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }

  .project-details {
    list-style: none;
    margin-bottom: 1rem;
  }
  .project-details li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.875rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .project-details li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 1rem;
  }
  .project-tech span {
    font-size: 0.7rem;
    color: var(--light);
    padding: 0.15rem 0.4rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 3px;
  }

  .project-links {
    display: flex;
    gap: 1rem;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    color: var(--accent);
    text-decoration: none;
  }
  .project-link:hover {
    text-decoration: underline;
  }
  .project-link svg {
    width: 16px;
    height: 16px;
  }
</style>
